#include <iostream>
using namespace std;

class Complex
{
    int real, imag;

public:
    Complex()
    {
        real = 0;
        imag = 0;
    }

    Complex(int r, int i)
    {
        real = r;
        imag = i;
    }

    // Type conversion from int to Complex
    Complex(int n)
    {
        real = n;
        imag = 0;
    }

    // Operator overloading
    Complex operator +(Complex c)
    {
        Complex temp;
        temp.real = real + c.real;
        temp.imag = imag + c.imag;
        return temp;
    }

    void display()
    {
        cout << real << " + " << imag << "i" << endl;
    }
};

int main()
{
    Complex c1(3, 4), c2(2, 5), c3;

    c3 = c1 + c2;

    cout << "Addition of complex numbers: " << endl;
    c3.display();

    Complex c4;
    c4 = c1 + 5;

    cout << "Addition with integer using type conversion: " << endl;
    c4.display();

    return 0;
}
